{
  "version": "0.1.0",
  "sourceOfTruth": "template-luna-atlas-guide",
  "visualIntent": {
    "style": "cozy pixel companion",
    "scaleReadability": "clear at desktop idle scale",
    "emotionPriority": ["idle", "coding", "watching_video", "sleepy", "happy"]
  },
  "atlas": {
    "file": "sprite-atlas.png",
    "cellWidth": 64,
    "cellHeight": 64,
    "columns": 4,
    "rows": 16,
    "safePadding": 2,
    "rowOrder": [
      "idle_loop",
      "thinking_loop",
      "coding_loop",
      "watching_loop",
      "chatting_loop",
      "gaming_loop",
      "sleep_loop",
      "happy_react",
      "excited_loop",
      "drag",
      "idle_to_thinking",
      "thinking_to_idle",
      "thinking_to_sleep",
      "idle_to_happy",
      "welcome_back",
      "tap_affection"
    ],
    "clipFrameCounts": {
      "idle_loop": 4,
      "thinking_loop": 4,
      "coding_loop": 4,
      "watching_loop": 4,
      "chatting_loop": 4,
      "gaming_loop": 4,
      "sleep_loop": 4,
      "happy_react": 4,
      "excited_loop": 4,
      "drag": 4,
      "idle_to_thinking": 4,
      "thinking_to_idle": 4,
      "thinking_to_sleep": 4,
      "idle_to_happy": 4,
      "welcome_back": 4,
      "tap_affection": 4
    }
  },
  "anchors": {
    "speechBubble": { "x": 0, "y": -36 },
    "dragHandle": { "x": 0, "y": -8 },
    "interactionFocus": { "x": 0, "y": -18 },
    "tailPivot": { "x": 14, "y": 12 },
    "earLeft": { "x": -10, "y": -18 },
    "earRight": { "x": 10, "y": -18 }
  },
  "expressionLanguage": {
    "idle": {
      "eyes": "soft and relaxed",
      "mouth": "small neutral smile",
      "ears": "subtle sway",
      "tail": "low amplitude rhythm",
      "body": "gentle breathing"
    }
  },
  "deliveryChecklist": [
    "Atlas rows match rowOrder exactly",
    "Idle and coding loops stay readable at small desktop scale",
    "Transitions do not snap harshly",
    "Face stays readable during blink and half-lid states"
  ]
}
